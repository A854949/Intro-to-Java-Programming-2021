package P06_06122238;

import java.util.Scanner;

public class P06_06122238_01 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner input = new Scanner(System.in);
		String[] student = {"學生A", "學生B", "學生C", "學生D"};
		double sum = 0;
		int score;
		for (int i = 0; i < 4; i++) {
			double[] scores = new double[12]; 
			System.out.print("請輸入學生成績: ");
			score = input.nextInt();
			sum += scores[i];
			System.out.print("學生A" + score);	
			
		}
		double average = sum / 3;
		"平均: " + average);
		System.out.println("學生B" + score + "平均: " + average);
		System.out.println("學生C" + score + "平均: " + average);
		System.out.println("學生D" + score + "平均: " + average);
			
	}

}

